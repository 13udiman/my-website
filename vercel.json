{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/quiz1", "destination": "index.html" },
    { "source": "/quiz1/profile", "destination": "/quiz1/profile/index.html" },
    { "source": "/quiz1/hometown", "destination": "/quiz1/hometown/index.html" },
    { "source": "/quiz1/food", "destination": "/quiz1/food/index.html" },
    { "source": "/quiz1/tourist", "destination": "/quiz1/tourist/index.html" },
    
    { "source": "/css/(.*)", "destination": "/quiz1/css/$1" },
    { "source": "/js/(.*)", "destination": "/quiz1/js/$1" },
    { "source": "/images/(.*)", "destination": "/quiz1/images/$1" }
  ]
}
